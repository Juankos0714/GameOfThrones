# Archivo de Poniente - Variables de entorno
# Copia este archivo a .env y rellena los valores

# ── Supabase (lectura de datos y Storage desde el cliente) ──
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ── Better Auth (conexión Postgres de Supabase, usada por el servidor) ──
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── Better Auth secret (para firmar sesiones) ──
BETTER_AUTH_SECRET=tu-secret-aleatorio-aqui

# ── Supabase service_role key (solo servidor — NUNCA en el cliente) ──
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ── URL del servidor de Better Auth (para CORS del cliente) ──
VITE_AUTH_URL=http://localhost:3000
